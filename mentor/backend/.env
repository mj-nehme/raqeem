NAMESPACE=default
MENTOR_BACKEND_PREFERRED_NODEPORT=30090
# Optional: devices API URL. If empty, discovered from Kubernetes service.
DEVICES_API_URL=

# Optional: override CORS origin regex for allowed frontends
# Default (if unset) allows any localhost port: ^http://localhost(:[0-9]+)?$
# CORS_ORIGIN_REGEX=

# Object storage configuration (S3/MinIO compatible)
# Internal endpoint (ClusterIP or external URL)
BUCKET_ENDPOINT=http://minio-service.default.svc.cluster.local:9000
# Public endpoint used in presigned URLs (browser-accessible)
BUCKET_PUBLIC_ENDPOINT=http://localhost:30421
# Bucket name for screenshots
BUCKET_NAME=raqeem-screenshots
# .env or your own config file
POSTGRES_USER=monitor
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=monitoring_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
